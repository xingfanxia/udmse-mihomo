[Unit]
Description=Mihomo scoped proxy
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
UMask=0077
ExecStartPre=/data/mihomo/mihomo-routing.sh guard
ExecStartPre=/data/mihomo/mihomo -t -d /data/mihomo
ExecStart=/data/mihomo/mihomo -d /data/mihomo
ExecStopPost=/data/mihomo/mihomo-routing.sh cleanup
Restart=no
MemoryMax=512M
CPUQuota=100%
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
