# Copied to /data/mihomo/routing.env with mode 0600. Root-owned shell config.
# Reserve the pilot device's IPv4 address in DHCP and supply BOTH identifiers.
SCOPE=devices
LAN_INTERFACES=(br0)
# Concrete IPv4 address owned by the router's selected LAN bridge; no wildcard.
DNS_LISTEN_IPV4='192.168.1.1'
DEVICE_IPV4=''
DEVICE_MAC=''

# For an explicitly selected subnet instead, set SCOPE=networks and list CIDRs.
# Never include the whole LAN accidentally. Empty scopes refuse activation.
SOURCE_CIDRS=()

# This version supports IPv4 only. Activation refuses an active IPv6 default
# route; configure IPv6 off through UniFi before using this pilot.
IPV6_POLICY=require-no-default
